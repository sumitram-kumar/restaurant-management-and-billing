# Copy to .env.test for running the test suite locally. A separate
# database from dev (billing_test) so tests can freely truncate tables.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/billing_test"
DIRECT_URL="postgresql://postgres:devpassword@localhost:5432/billing_test"
PORT=5001
CORS_ORIGIN="http://localhost:3000"
AUTH0_AUDIENCE="https://your-api-identifier"
AUTH0_ISSUER_BASE_URL="https://your-tenant.us.auth0.com/"
LOG_LEVEL=silent
