# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection strings used by Prisma.
# DATABASE_URL: what the running app queries through — the transaction-mode
# pooler in production, so a burst of short-lived connections doesn't
# exhaust the database's connection limit.
# DIRECT_URL: what `prisma migrate` uses. The transaction pooler specifically
# doesn't preserve session state across statements, which breaks the
# advisory lock Migrate takes out to serialize concurrent migrations — the
# session-mode pooler (or an unpooled connection) doesn't have that problem.
# Locally these are identical since there's no pooler in front of a local
# Postgres either way.
#
# Local Docker Compose default:
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/billing"
DIRECT_URL="postgresql://postgres:devpassword@localhost:5432/billing"
#
# Supabase (production) looks like:
# DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Port the API listens on.
PORT=5000

# Origin allowed to call the API from the browser (the React dev server / deployed frontend).
CORS_ORIGIN="http://localhost:3000"

# Auth0: Applications > APIs > (your API) > Identifier, and your tenant domain.
AUTH0_AUDIENCE="https://your-api-identifier"
AUTH0_ISSUER_BASE_URL="https://your-tenant.us.auth0.com/"
