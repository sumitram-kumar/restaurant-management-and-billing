# Copy to .env for local development. CRA only embeds vars prefixed
# REACT_APP_, and only at build time — restart `npm start` after changes.

REACT_APP_API_BASE_URL="http://localhost:5000"

# Auth0: Applications > Applications > (your SPA) for domain/client id;
# Applications > APIs > (your API) > Identifier for the audience.
REACT_APP_AUTH0_DOMAIN="your-tenant.us.auth0.com"
REACT_APP_AUTH0_CLIENT_ID="your-spa-client-id"
REACT_APP_AUTH0_AUDIENCE="https://your-api-identifier"
